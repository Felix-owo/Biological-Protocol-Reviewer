{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_report.schema.json",
  "type": "object",
  "required": [
    "protocol_reconstruction",
    "readiness",
    "protocol_readiness_contract",
    "module_activation",
    "evidence_benchmark",
    "parameter_authority_isolation",
    "readout_contracts",
    "protocol_panel_synthesis",
    "issues",
    "qc_and_metadata_review",
    "safety_governance_review",
    "operator_burden_budget",
    "mini_pilot_plan",
    "parameter_provenance",
    "review_to_sop_mapping"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_reconstruction": {
      "type": "object",
      "required": [
        "intended_result",
        "primary_readout",
        "experimental_unit",
        "fragile_step"
      ],
      "additionalProperties": false,
      "properties": {
        "intended_result": {
          "type": "string",
          "minLength": 8
        },
        "primary_readout": {
          "type": "string",
          "minLength": 4
        },
        "experimental_unit": {
          "type": "string",
          "minLength": 4
        },
        "fragile_step": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "score",
        "maturity_level",
        "execution_gate"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maturity_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "execution_gate": {
          "type": "string",
          "enum": [
            "blocked",
            "pilot_required",
            "executable_with_controls",
            "ready"
          ]
        }
      }
    },
    "user_supplied_corpus_handling": {
      "type": "array"
    },
    "protocol_readiness_contract": {
      "type": "object"
    },
    "claim_readout_handoff": {
      "$ref": "claim_readout_handoff.schema.json"
    },
    "module_activation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_benchmark": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "benchmark_question",
          "source_grade",
          "source_identity",
          "parameter_or_control",
          "local_status"
        ],
        "additionalProperties": false,
        "properties": {
          "benchmark_question": {
            "type": "string",
            "minLength": 8
          },
          "source_grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "source_identity": {
            "type": "string",
            "minLength": 4
          },
          "parameter_or_control": {
            "type": "string",
            "minLength": 3
          },
          "local_status": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "parameter_authority_isolation": {
      "type": "array",
      "minItems": 1
    },
    "readout_contracts": {
      "type": "array",
      "minItems": 1
    },
    "data_records_repository_gate": {
      "type": "array"
    },
    "protocol_panel_synthesis": {
      "type": "array",
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "issue.schema.json"
      }
    },
    "qc_and_metadata_review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "qc_gate.schema.json"
      }
    },
    "safety_governance_review": {
      "type": "string",
      "minLength": 12
    },
    "operator_burden_budget": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "added_requirement",
          "burden",
          "justification"
        ],
        "additionalProperties": false,
        "properties": {
          "added_requirement": {
            "type": "string",
            "minLength": 4
          },
          "burden": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "mini_pilot_plan": {
      "type": "string",
      "minLength": 12
    },
    "parameter_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "parameter_provenance.schema.json"
      }
    },
    "review_to_sop_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "sop_section"
        ],
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 3
          },
          "sop_section": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "protocol_passport_summary": {
      "type": "object"
    },
    "external_companion_evidence": {
      "type": "array",
      "items": {
        "$ref": "external_companion_evidence.schema.json"
      }
    }
  }
}

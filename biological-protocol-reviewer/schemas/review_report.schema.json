{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_report.schema.json",
  "type": "object",
  "required": [
    "runtime_profile",
    "profile_contract",
    "protocol_reconstruction",
    "readiness",
    "protocol_readiness_contract",
    "module_activation",
    "evidence_benchmark",
    "parameter_authority_isolation",
    "readout_contracts",
    "issues",
    "qc_and_metadata_review",
    "safety_governance_review",
    "parameter_provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "runtime_profile": {
      "type": "string",
      "enum": [
        "protocol_gate",
        "protocol_full",
        "delta_review"
      ]
    },
    "profile_contract": {
      "type": "object",
      "required": [
        "protocol_panel_applicable",
        "operator_burden_applicable",
        "mini_pilot_applicable",
        "review_to_sop_mapping_applicable"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol_panel_applicable": {
          "type": "boolean"
        },
        "operator_burden_applicable": {
          "type": "boolean"
        },
        "mini_pilot_applicable": {
          "type": "boolean"
        },
        "review_to_sop_mapping_applicable": {
          "type": "boolean"
        }
      }
    },
    "delta_review_trace": {
      "type": "object",
      "required": [
        "prior_review_id",
        "changed_artifact_ids",
        "prior_open_finding_ids",
        "resolved_finding_ids",
        "new_finding_ids",
        "carried_forward_finding_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "prior_review_id": {
          "type": "string",
          "minLength": 3
        },
        "changed_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "prior_open_finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "resolved_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "new_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "carried_forward_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "protocol_reconstruction": {
      "type": "object",
      "required": [
        "intended_result",
        "primary_readout",
        "experimental_unit",
        "fragile_step"
      ],
      "additionalProperties": false,
      "properties": {
        "intended_result": {
          "type": "string",
          "minLength": 8
        },
        "primary_readout": {
          "type": "string",
          "minLength": 4
        },
        "experimental_unit": {
          "type": "string",
          "minLength": 4
        },
        "fragile_step": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "score",
        "maturity_level",
        "execution_gate"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "maturity_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "execution_gate": {
          "type": "string",
          "enum": [
            "blocked",
            "pilot_required",
            "executable_with_controls",
            "ready"
          ]
        }
      }
    },
    "user_supplied_corpus_handling": {
      "type": "array"
    },
    "protocol_readiness_contract": {
      "type": "object"
    },
    "claim_readout_handoff": {
      "$ref": "claim_readout_handoff.schema.json"
    },
    "module_activation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_benchmark": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "benchmark_question",
          "source_grade",
          "source_identity",
          "parameter_or_control",
          "local_status"
        ],
        "additionalProperties": false,
        "properties": {
          "benchmark_question": {
            "type": "string",
            "minLength": 8
          },
          "source_grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "source_identity": {
            "type": "string",
            "minLength": 4
          },
          "parameter_or_control": {
            "type": "string",
            "minLength": 3
          },
          "local_status": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "parameter_authority_isolation": {
      "type": "array",
      "minItems": 1
    },
    "readout_contracts": {
      "type": "array",
      "minItems": 1
    },
    "data_records_repository_gate": {
      "type": "array"
    },
    "protocol_panel_synthesis": {
      "type": "array",
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "issue.schema.json"
      }
    },
    "qc_and_metadata_review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "qc_gate.schema.json"
      }
    },
    "safety_governance_review": {
      "type": "string",
      "minLength": 12
    },
    "operator_burden_budget": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "added_requirement",
          "burden",
          "justification"
        ],
        "additionalProperties": false,
        "properties": {
          "added_requirement": {
            "type": "string",
            "minLength": 4
          },
          "burden": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "mini_pilot_plan": {
      "type": "string",
      "minLength": 12
    },
    "parameter_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "parameter_provenance.schema.json"
      }
    },
    "review_to_sop_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "sop_section"
        ],
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 3
          },
          "sop_section": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "protocol_passport_summary": {
      "type": "object"
    },
    "external_companion_evidence": {
      "type": "array",
      "items": {
        "$ref": "external_companion_evidence.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "runtime_profile"
        ],
        "properties": {
          "runtime_profile": {
            "const": "protocol_full"
          }
        }
      },
      "then": {
        "required": [
          "protocol_panel_synthesis",
          "operator_burden_budget",
          "mini_pilot_plan",
          "review_to_sop_mapping"
        ],
        "properties": {
          "profile_contract": {
            "properties": {
              "protocol_panel_applicable": {
                "const": true
              },
              "operator_burden_applicable": {
                "const": true
              },
              "mini_pilot_applicable": {
                "const": true
              },
              "review_to_sop_mapping_applicable": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "runtime_profile"
        ],
        "properties": {
          "runtime_profile": {
            "const": "delta_review"
          }
        }
      },
      "then": {
        "required": [
          "delta_review_trace"
        ]
      }
    },
    {
      "if": {
        "required": [
          "profile_contract"
        ],
        "properties": {
          "profile_contract": {
            "required": [
              "protocol_panel_applicable"
            ],
            "properties": {
              "protocol_panel_applicable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "protocol_panel_synthesis"
        ]
      }
    },
    {
      "if": {
        "required": [
          "profile_contract"
        ],
        "properties": {
          "profile_contract": {
            "required": [
              "operator_burden_applicable"
            ],
            "properties": {
              "operator_burden_applicable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "operator_burden_budget"
        ]
      }
    },
    {
      "if": {
        "required": [
          "profile_contract"
        ],
        "properties": {
          "profile_contract": {
            "required": [
              "mini_pilot_applicable"
            ],
            "properties": {
              "mini_pilot_applicable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "mini_pilot_plan"
        ]
      }
    },
    {
      "if": {
        "required": [
          "profile_contract"
        ],
        "properties": {
          "profile_contract": {
            "required": [
              "review_to_sop_mapping_applicable"
            ],
            "properties": {
              "review_to_sop_mapping_applicable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "review_to_sop_mapping"
        ]
      }
    }
  ]
}

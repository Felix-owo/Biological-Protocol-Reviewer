{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revised_protocol.schema.json",
  "type": "object",
  "required": [
    "document_control",
    "execution_summary",
    "before_you_begin",
    "steps",
    "reagent_setup",
    "resources",
    "qc_gates",
    "timing",
    "troubleshooting",
    "anticipated_results",
    "minimal_analysis",
    "appendices"
  ],
  "additionalProperties": false,
  "properties": {
    "document_control": {
      "type": "object",
      "required": ["title", "version", "owner", "effective_date"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 4 },
        "version": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 3 },
        "effective_date": { "type": "string", "minLength": 4 }
      }
    },
    "execution_summary": { "type": "string", "minLength": 12 },
    "before_you_begin": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 4 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_number",
          "action",
          "critical_parameters",
          "qc_gate",
          "failure_mode",
          "troubleshooting",
          "record_fields",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 12 },
          "critical_parameters": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "qc_gate": { "type": "string", "minLength": 3 },
          "failure_mode": { "type": "string", "minLength": 8 },
          "troubleshooting": { "type": "string", "minLength": 8 },
          "record_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "provenance": { "type": "string", "minLength": 4 }
        }
      }
    },
    "reagent_setup": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "parameter_provenance.schema.json" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource", "identifier", "lot_or_version", "purpose"],
        "additionalProperties": false,
        "properties": {
          "resource": { "type": "string", "minLength": 3 },
          "identifier": { "type": "string", "minLength": 3 },
          "lot_or_version": { "type": "string", "minLength": 2 },
          "purpose": { "type": "string", "minLength": 4 }
        }
      }
    },
    "qc_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "qc_gate.schema.json" }
    },
    "timing": { "type": "string", "minLength": 4 },
    "troubleshooting": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "anticipated_results": { "type": "string", "minLength": 8 },
    "minimal_analysis": { "type": "string", "minLength": 8 },
    "bioinformatics_handoff": { "$ref": "bioinformatics_handoff.schema.json" },
    "appendices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}

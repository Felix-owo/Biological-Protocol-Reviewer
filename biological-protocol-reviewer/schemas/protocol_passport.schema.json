{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol_passport.schema.json",
  "type": "object",
  "required": [
    "protocol_id",
    "skill_version",
    "source_materials",
    "sample_material",
    "primary_readout",
    "experimental_unit",
    "module_activation",
    "parameter_authority",
    "qc_gates",
    "local_validation_status",
    "safety_governance_status",
    "unresolved_gaps",
    "mini_pilot_plan",
    "review_to_sop_mapping",
    "validator_status"
  ],
  "additionalProperties": true,
  "properties": {
    "protocol_id": { "type": "string" },
    "skill_version": { "type": "string", "minLength": 8 },
    "source_materials": {
      "type": "object",
      "additionalProperties": true
    },
    "sample_material": {
      "type": "object",
      "additionalProperties": true
    },
    "primary_readout": { "type": "string", "minLength": 4 },
    "experimental_unit": { "type": "string", "minLength": 4 },
    "module_activation": {
      "type": "object",
      "required": ["activated", "unclear", "not_applicable"],
      "additionalProperties": true,
      "properties": {
        "activated": { "type": "array" },
        "unclear": { "type": "array" },
        "not_applicable": { "type": "array" }
      }
    },
    "resource_identity": {
      "type": "object",
      "additionalProperties": true
    },
    "parameter_authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "value",
          "authority_class",
          "source_identity",
          "local_validation_status",
          "sop_label"
        ],
        "additionalProperties": true,
        "properties": {
          "parameter": { "type": "string", "minLength": 2 },
          "value": { "type": "string" },
          "authority_class": { "type": "string", "minLength": 4 },
          "source_identity": { "type": "string" },
          "local_validation_status": { "type": "string", "minLength": 4 },
          "sop_label": { "type": "string" }
        }
      }
    },
    "qc_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "readout_id", "acceptance_criterion", "fail_action"],
        "additionalProperties": true,
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "readout_id": { "type": "string", "minLength": 1 },
          "acceptance_criterion": { "type": "string", "minLength": 4 },
          "fail_action": { "type": "string", "minLength": 4 }
        }
      }
    },
    "local_validation_status": { "type": "string", "minLength": 4 },
    "safety_governance_status": {
      "type": "object",
      "additionalProperties": true
    },
    "unresolved_gaps": { "type": "array" },
    "mini_pilot_plan": {
      "type": "object",
      "required": ["required", "summary"],
      "additionalProperties": true,
      "properties": {
        "required": { "type": "boolean" },
        "summary": { "type": "string" }
      }
    },
    "review_to_sop_mapping": {
      "type": "array",
      "minItems": 1
    },
    "validator_status": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol_passport.schema.json",
  "type": "object",
  "required": [
    "protocol_id",
    "skill_version",
    "source_materials",
    "sample_material",
    "primary_readout",
    "experimental_unit",
    "module_activation",
    "parameter_authority",
    "qc_gates",
    "local_validation_status",
    "safety_governance_status",
    "unresolved_gaps",
    "mini_pilot_plan",
    "review_to_sop_mapping",
    "validator_status"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 3
    },
    "skill_version": {
      "type": "string",
      "minLength": 8
    },
    "source_materials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_supplied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "exclusion_reason": {
                "type": "string"
              }
            }
          }
        },
        "external_sources_checked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "grade": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "sample_material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organism_or_cell_type": {
          "type": "string"
        },
        "sample_type": {
          "type": "string"
        },
        "input_constraints": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "primary_readout": {
      "type": "string",
      "minLength": 4
    },
    "experimental_unit": {
      "type": "string",
      "minLength": 4
    },
    "module_activation": {
      "type": "object",
      "required": [
        "activated",
        "unclear",
        "not_applicable"
      ],
      "additionalProperties": false,
      "properties": {
        "activated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unclear": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_required_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complete_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "parameter_authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "value",
          "authority_class",
          "source_identity",
          "local_validation_status",
          "sop_label"
        ],
        "additionalProperties": false,
        "properties": {
          "parameter": {
            "type": "string",
            "minLength": 2
          },
          "value": {
            "type": "string"
          },
          "authority_class": {
            "type": "string",
            "minLength": 4
          },
          "source_identity": {
            "type": "string",
            "minLength": 2
          },
          "local_validation_status": {
            "type": "string",
            "minLength": 4
          },
          "sop_label": {
            "type": "string"
          },
          "identifier_type": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "source_title": {
            "type": "string"
          },
          "access_date": {
            "type": "string"
          },
          "supports_parameter_or_qc": {
            "type": "string"
          },
          "evidence_grade": {
            "type": "string"
          }
        }
      }
    },
    "qc_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "readout_id",
          "acceptance_criterion",
          "fail_action"
        ],
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "readout_id": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criterion": {
            "type": "string",
            "minLength": 4
          },
          "fail_action": {
            "type": "string",
            "minLength": 4
          },
          "measurement_method": {
            "type": "string"
          },
          "record_field": {
            "type": "string"
          }
        }
      }
    },
    "local_validation_status": {
      "type": "string",
      "minLength": 4
    },
    "safety_governance_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "red_line_status": {
          "type": "string"
        },
        "approvals_or_placeholders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gap": {
            "type": "string"
          },
          "blocks": {
            "type": "string"
          },
          "confirmation_owner": {
            "type": "string"
          }
        }
      }
    },
    "mini_pilot_plan": {
      "type": "object",
      "required": [
        "required",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "review_to_sop_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "sop_section": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "validator_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_report": {
          "type": "string"
        },
        "revised_protocol": {
          "type": "string"
        },
        "structured_passport": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

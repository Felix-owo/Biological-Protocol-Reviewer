{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external_companion_evidence.schema.json",
  "type": "object",
  "required": [
    "companion_class",
    "tool_or_skill",
    "query_or_task",
    "returned_identifier",
    "primary_source_resolved",
    "exact_parameter_control_qc_or_metadata_field_affected",
    "evidence_role",
    "protocol_section_affected",
    "limitation",
    "verification_status",
    "access_date",
    "identifier_type",
    "identifier",
    "resolved_source_grade"
  ],
  "additionalProperties": false,
  "properties": {
    "companion_class": {
      "type": "string",
      "enum": [
        "official_plugin",
        "external_skill",
        "mcp_tool",
        "host_tool",
        "manual_lookup"
      ]
    },
    "tool_or_skill": {
      "type": "string",
      "minLength": 2
    },
    "query_or_task": {
      "type": "string",
      "minLength": 4
    },
    "returned_identifier": {
      "type": "string",
      "minLength": 2
    },
    "primary_source_resolved": {
      "type": "string",
      "minLength": 8
    },
    "exact_parameter_control_qc_or_metadata_field_affected": {
      "type": "string",
      "minLength": 3
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "supports",
        "weakens",
        "narrows",
        "neutral",
        "context",
        "search_route"
      ]
    },
    "protocol_section_affected": {
      "type": "string",
      "minLength": 3
    },
    "limitation": {
      "type": "string",
      "minLength": 8
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "resolved_to_grade_a_to_c_source",
        "resolved_to_grade_d_context",
        "to_be_confirmed",
        "to_be_verified_before_execution"
      ]
    },
    "access_date": {
      "type": "string",
      "minLength": 4,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notes": {
      "type": "string"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "DOI",
        "PMID",
        "PMCID",
        "RRID",
        "official_url",
        "vendor_manual",
        "repository_accession",
        "local_sop",
        "standard_or_guideline",
        "unresolved"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 2
    },
    "resolved_source_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unresolved"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioinformatics_handoff.schema.json",
  "type": "object",
  "required": [
    "raw_data_manifest",
    "checksum_plan",
    "software_versions",
    "reference_versions",
    "minimum_metadata",
    "rerun_test",
    "repository_plan"
  ],
  "additionalProperties": false,
  "properties": {
    "raw_data_manifest": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "checksum_plan": { "type": "string", "minLength": 8 },
    "software_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "reference_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "minimum_metadata": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "rerun_test": { "type": "string", "minLength": 8 },
    "repository_plan": { "type": "string", "minLength": 8 }
  }
}
